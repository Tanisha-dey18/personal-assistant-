# ============================================================
#  ASTRA backend configuration — copy to backend/.env and fill in
# ============================================================

# --- Core ---------------------------------------------------
# set to "production" when deployed
ENV=development
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Encrypts sensitive memories + OAuth tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Keep it safe: if you lose it, encrypted memories can't be read.
ENCRYPTION_KEY=
# set false after creating your own account
ALLOW_REGISTRATION=true

FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI brain (REQUIRED for chat) -----------------------------
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (OpenRouter, Groq, Together, Ollama http://localhost:11434/v1)
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4.1-mini
FAST_MODEL=gpt-4.1-mini
AVAILABLE_MODELS=gpt-4.1-mini,gpt-4.1,gpt-4o,gpt-4o-mini,gpt-5,gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
# must match the embedding model
EMBEDDING_DIM=1536
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
DEFAULT_VOICE=nova

# --- Storage --------------------------------------------------
# Leave these empty for zero-setup local dev (SQLite file + embedded Qdrant in ./data).
# docker-compose sets them for Postgres + Qdrant + Redis automatically.
DATABASE_URL=sqlite+aiosqlite:///./data/astra.db
# DATABASE_URL=postgresql+asyncpg://astra:astra@localhost:5432/astra
QDRANT_URL=
QDRANT_API_KEY=
REDIS_URL=

# --- Optional integrations -----------------------------------
# web search — https://tavily.com (free tier)
TAVILY_API_KEY=
# Gmail + Calendar — see README "Google setup"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Limits ---------------------------------------------------
RATE_LIMIT_PER_MINUTE=40
AUTH_RATE_LIMIT_PER_MINUTE=10
PROACTIVE_INTERVAL_SECONDS=60
MAX_UPLOAD_MB=25
